@page "/Units"
@model WebApp.Pages.UnitListModel
@{
}
<div class="container">
	<div class="row">
		<h2>Unit Page</h2>
		<p>Here you can view units from your database.</p>
	</div>
</div>
<div class="container">
	<div class="row">
		@foreach (var category in Model.SortedCategories) 
		{
			<p>@category</p>
			@foreach (var unit in Model.Units.Where(u => u.Category == category))
			{
				<span>@unit.Name</span>
			}
		}
	</div>
</div>
