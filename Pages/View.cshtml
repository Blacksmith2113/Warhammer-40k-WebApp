@page
@model WebApp.Pages.ViewModel
@{
}
<div class="container">
<div class="row">
		<div class="col-12">
			<!-- Page title -->
					<a asp-page="/UnitList" rel="tooltip">
						<i class="material-symbols-outlined">arrow_back</i>
					</a>
			<div class="my-5">
				<h3>Unit Information</h3>
				<hr>
			</div>
			<!-- Form START -->
				<div class="row mb-5 gx-5">
					<!-- Image -->
					<div class="col-xxl-4">
						<div class="bg-secondary-soft px-4 py-5 rounded h-100">
							<div class="row g-3">
								<h4 class="mb-4 mt-0 text-center" >Unit's picture</h4>
								<div class="text-center">
									<!-- Image -->
									<div class="square position-relative display-2 mb-3">
										@{
											// Sprawdzamy w C#, czy obiekt Unit ma zapisane zdjęcie
											bool maZdjecie = Model.Unit?.Image != null && Model.Unit.Image.Length > 0;
											string imageSrc = "#";
                        
											if (maZdjecie)
											{
												// Konwersja byte[] z bazy danych na Base64
												string base64 = Convert.ToBase64String(Model.Unit.Image);
												imageSrc = $"data:image/png;base64,{base64}";
											}
										}

										@if (!maZdjecie)
										{
											<i class="fas fa-fw fa-user position-absolute top-50 start-50 translate-middle text-secondary"></i>
										}
										else
										{
											<img src="@imageSrc" alt="@Model.Unit.Name" class="img-fluid w-100 h-100" style="object-fit: cover;" />
										}
										<img id="imagePreview" src="#" alt="Unit Preview" class="img-fluid w-100 h-100" style="object-fit: cover; display: none;"/>
									</div>
								</div>
							</div>
						</div>
					</div>
					<!-- Unit Information -->
					<div class="col-xxl-8 mb-5 mb-xxl-0">
						<div class="bg-secondary-soft px-4 py-5 rounded  h-100">
							<div class="row g-3">
								<h4 class="mb-4 mt-0">Unit Informations</h4>
								<!-- Name -->
								<div class="col-md-6">
									<label class="form-label">Name</label>
									<p class="form-control-plaintext">@Model.Unit.Name</p>
								</div>
								<!-- Points -->
								<div class="col-md-6">
									<label class="form-label">Point Value</label>
									<p class="form-label">@Model.Unit.Points</p>
								</div>
								<!--Category-->
								<div class="col-md-6">
									<label class="form-label">Category</label>
									<p class="form-control-plaintext">@Model.Unit.Category</p>
								</div>
								<!--Additional Rules-->
								<div class="col-md-6">
									<label class="form-label">Additional Rules</label>
									<p class="form-label">
									@{
										if(Model.Unit.Rules != null)
										{
											@Model.Unit.Rules
										}
										else
										{
											<span>This unit doesn't have addditional rules</span>
										}
									}
										</p>
								</div>
							</div> <!-- Row END -->
						</div>
					</div>
				</div> <!-- Row END -->
		</div>
	</div>
	</div>