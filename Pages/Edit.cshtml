@page
@model WebApp.Pages.EditModel
@{
}
<div class="container">
<div class="row">
		<div class="col-12">
			<!-- Page title -->
					<a asp-page="/UnitList" rel="tooltip">
						<i class="material-symbols-outlined">arrow_back</i>
					</a>
			<div class="my-5">
				<h3>Edit unit</h3>
				<hr>
			</div>
			<!-- Form START -->
			<form class="file-upload" enctype="multipart/form-data" method="post">
				<input type="hidden" asp-for="Unit.Id" />
				<div class="row mb-5 gx-5">
					<!-- Upload Image -->
					<div class="col-xxl-4">
						<div class="bg-secondary-soft px-4 py-5 rounded h-100">
							<div class="row g-3">
								<h4 class="mb-4 mt-0 text-center" >Upload unit's picture</h4>
								<div class="text-center">
									<!-- Image upload -->
									<div class="square position-relative display-2 mb-3">
										@{
											bool hasImage = Model.Unit?.Image != null && Model.Unit.Image.Length > 0;
											string imageSrc = "#";
											if (hasImage)
											{
												string base64 = Convert.ToBase64String(Model.Unit.Image);
												imageSrc = $"data:image/png;base64,{base64}";
											}
										}
										<i id="uploadIcon" class="fas fa-fw fa-user position-absolute top-50 start-50 translate-middle text-secondary" style="display: none"></i>
										<img id="imagePreview" src="@imageSrc" alt="Unit Preview" class="img-fluid w-100 h-100" style="object-fit: cover;"/>
									</div>
									<!-- Button -->
									<input type="file" id="customFile" asp-for="ImageFile" name="ImageFile" hidden>
									<label class="btn btn-info btn-block " for="customFile">Upload</label>
									<button id="removeBtn" type="button" class="btn btn-danger">Remove</button>
								</div>
							</div>
						</div>
					</div>
					<!-- Unit Information -->
					<div class="col-xxl-8 mb-5 mb-xxl-0">
						<div class="bg-secondary-soft px-4 py-5 rounded  h-100">
							<div class="row g-3">
								<h4 class="mb-4 mt-0">Unit Information</h4>
								<!-- Name -->
								<div class="col-md-6">
									<label class="form-label">Name</label>
									<input type="text" asp-for="Unit.Name" class="form-control" aria-label="First name">
								</div>
								<!-- Points -->
								<div class="col-md-6">
									<label class="form-label">Points</label>
									<input type="text" asp-for="Unit.Points" class="form-control" aria-label="Last name">
								</div>
								<!--Category-->
								<div class="col-md-6">
									<label class="form-label">Category</label>
									<select asp-for="Unit.Category" class="form-select">
										<option selected disabled value="">Select Category</option>
										<option value="Character">Character</option>
										<option value="Battleline">Battleline</option>
										<option value="Dedicated Transport">Dedicated Transport</option>
										<option value="Other Datasheets">Other Datasheets</option>
									</select>
								</div>
								<!--Additional Rules-->
								<div class="col-md-6">
									<label class="form-label">Additional Rules</label>
									<textarea asp-for="Unit.Rules" class="form-control" rows="3"></textarea>
								</div>
							</div> <!-- Row END -->
						</div>
					</div>
				</div> <!-- Row END -->
				<!-- button -->
				<div class="d-flex justify-content-end gap-3 mb-5 mt-4 pb-5">
					<button type="submit" class="btn btn-primary btn-lg px-5" >Edit Unit</button>
				</div>
			</form> <!-- Form END -->
		</div>
	</div>
	</div>