@page
@model WebApp.Pages.CreateModel
@{
}
<div class="container">
<div class="row">
		<div class="col-12">
			<!-- Page title -->
					<a asp-page="/UnitList" rel="tooltip">
						<i class="material-symbols-outlined">arrow_back</i>
					</a>
			<div class="my-5">
				<h3>Create new Unit</h3>
				<hr>
			</div>
			<!-- Form START -->
			<form method="post" enctype="multipart/form-data" class="file-upload">
				<div class="row mb-5 gx-5">
					<!-- Upload Image -->
					<div class="col-xxl-4">
						<div class="bg-secondary-soft px-4 py-5 rounded h-100">
							<div class="row g-3">
								<h4 class="mb-4 mt-0 text-center" >Upload unit's picture</h4>
								<div class="text-center">
									<!-- Image upload -->
									<div class="square position-relative display-2 mb-3">
										<i id="uploadIcon" class="fas fa-fw fa-user position-absolute top-50 start-50 translate-middle text-secondary"></i>
										<img id="imagePreview" src="#" alt="Unit Preview" class="img-fluid w-100 h-100" style="object-fit: cover; display: none;"/>
									</div>
									<!-- Button -->
									<input type="file" id="customFile" asp-for="ImageFile" hidden="">
									<label class="btn btn-info btn-block " for="customFile">Upload</label>
									<button type="button" id="removeBtn" class="btn btn-danger">Remove</button>
								</div>
							</div>
						</div>
					</div>
					<!-- Unit Information -->
					<div class="col-xxl-8 mb-5 mb-xxl-0">
						<div class="bg-secondary-soft px-4 py-5 rounded  h-100">
							<div class="row g-3">
								<h4 class="mb-4 mt-0">Unit Information</h4>
								<!-- Name -->
								<div class="col-md-6">
									<label class="form-label">Name</label>
									<input type="text" asp-for="Unit.Name" class="form-control" placeholder="" aria-label="First name">
								</div>
								<!-- Points -->
								<div class="col-md-6">
									<label class="form-label">Point Value</label>
									<input type="text" asp-for="Unit.Points" class="form-control" placeholder="" aria-label="Last name">
								</div>
								<!--Category-->
								<div class="col-md-6">
									<label class="form-label">Category</label>
									<select class="form-select" asp-for="Unit.Category">
										<option selected disabled value="">Select Category</option>
										<option value="Character">Character</option>
										<option value="Battleline">Battleline</option>
										<option value="Dedicated Transport">Dedicated Transport</option>
										<option value="Other Datasheets">Other Datasheets</option>
									</select>
								</div>
								<!--Additional Rules-->
								<div class="col-md-6">
									<label class="form-label">Additional Rules</label>
									<textarea asp-for="Unit.Rules" class="form-control" rows="3"></textarea>
								</div>
							</div> <!-- Row END -->
						</div>
					</div>
				</div> <!-- Row END -->
				<!-- button -->
				<div class="d-flex justify-content-end gap-3 mb-5 mt-4 pb-5">
					<button type="submit" class="btn btn-primary btn-lg px-5">Create Unit</button>
				</div>
			</form> <!-- Form END -->
		</div>
	</div>
	</div>